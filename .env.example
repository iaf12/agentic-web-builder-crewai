# # OpenAI-compatible endpoint served by vLLM.
# # RunPod pod proxy:  https://<POD_ID>-8000.proxy.runpod.net/v1
# # Same machine:      http://localhost:8000/v1
# LLM_BASE_URL=https://1gpu2tcfcs04lq-8000.proxy.runpod.net/v1
# LLM_API_KEY=HelloFahad
# # "openai/" prefix + the exact name vLLM serves
# # LLM_MODEL=openai/Qwen/Qwen2.5-Coder-14B-Instruct-AWQ
# LLM_MODEL=openai/qwen2.5-coder-14b
# # Model context is 32768 tokens: input + output must fit, so keep this at 6000
# LLM_MAX_TOKENS=6000
# # Must equal vLLM --max-model-len
# LLM_CONTEXT=32768
# # Maximum QA fix rounds before a project is flagged INCOMPLETE
# MAX_QA_ROUNDS=6


# vllm/vllm-openai:latest
# Qwen/Qwen2.5-Coder-14B-Instruct-AWQ --quantization awq --dtype float16 --host 0.0.0.0 --port 8000 --gpu-memory-utilization 0.90 --max-model-len 32768 --served-model-name qwen2.5-coder-14b --api-key HelloFahad